<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Stampeded.NET</PackageId>
    <Description>C# bindings to Stampeded, a PostgreSQL-backed job processor with state machines and behavior trees.</Description>
    <PackageTags>stampeded;postgresql;jobs;queue;background</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stampeded.Hosting" />
    <InternalsVisibleTo Include="Stampeded.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../native/upstream/LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="../../native/upstream.json" Pack="true" PackagePath="native/" />
    <None Include="../../native/upstream/crates/stampeded-ffi/include/stampeded.h" Pack="true" PackagePath="native/include/" />
    <None Include="../../native/upstream/crates/stampeded/schema/schema.sql" Pack="true" PackagePath="schema/" />
    <None Include="../../runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>
  <Target Name="RequireNativeLibrary" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_NativeAssetsForPackage Include="../../runtimes/*/native/stampeded_ffi.dll;../../runtimes/*/native/libstampeded_ffi.so;../../runtimes/*/native/libstampeded_ffi.dylib" />
    </ItemGroup>
    <Error Condition="'@(_NativeAssetsForPackage)' == ''" Text="Build native assets with scripts/build-native.sh before packing." />
  </Target>
</Project>
