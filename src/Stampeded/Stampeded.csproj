<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Stampeded.NET</PackageId>
    <Description>C# bindings to Stampeded, a PostgreSQL-backed job processor with state machines and behavior trees.</Description>
    <PackageTags>stampeded;postgresql;jobs;queue;background</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stampeded.Hosting" />
    <InternalsVisibleTo Include="Stampeded.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../artifacts/native-source/LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="../../artifacts/native-source/upstream.json" Pack="true" PackagePath="native/" />
    <None Include="../../native/Cargo.lock" Pack="true" PackagePath="native/" />
    <None Include="../../artifacts/native-source/stampeded.h" Pack="true" PackagePath="native/include/" />
    <None Include="../../artifacts/native-source/schema.sql" Pack="true" PackagePath="schema/" />
    <None Include="../../artifacts/native-source/migrations/*.sql" Pack="true" PackagePath="schema/migrations/" />
    <None Include="../../runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>
  <Target Name="RequireNativeLibrary" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_NativeAssetsForPackage Include="../../runtimes/*/native/stampeded_ffi.dll;../../runtimes/*/native/libstampeded_ffi.so;../../runtimes/*/native/libstampeded_ffi.dylib" />
    </ItemGroup>
    <Error Condition="'@(_NativeAssetsForPackage)' == ''" Text="Build native assets with scripts/build-native.sh before packing." />
    <Error Condition="!Exists('../../artifacts/native-source/upstream.json') Or !Exists('../../artifacts/native-source/schema.sql')" Text="Prepare the published crate sources with scripts/prepare-native.sh before packing." />
  </Target>
</Project>
